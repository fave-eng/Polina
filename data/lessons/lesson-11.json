    {
      "type": "exercise",
      "id": "l11-ex3",
      "layout": "prose-gaps wide-gaps",
      "title": "3. Use the words to write reasons for refusing the requests.",
      "items": [
        {
          "id": "1",
          "number": 1,
          "prompt": "A: I was wondering if you wanted to get together on Saturday?\nB: (love to / but can’t. go away / for the weekend.)",
          "example": true,
          "exampleAnswer": "I’d love to but I can’t. I’m going away for the weekend."
        },
        {
          "id": "2",
          "number": 2,
          "prompt": "",
          "input": "gaps",
          "segments": [
            "A: Can you give me a hand to set up my new computer?\nB: ",
            " (sorry / can’t. work late / this evening.)"
          ],
          "answers": [
            [
              "I’m sorry, I can’t. I’m working late this evening.",
              "I'm sorry, I can't. I'm working late this evening.",
              "I am sorry, I cannot. I am working late this evening.",
              "I’m sorry I can’t. I’m working late this evening.",
              "I'm sorry I can't. I'm working late this evening."
            ]
          ]
        },
        {
          "id": "3",
          "number": 3,
          "prompt": "",
          "input": "gaps",
          "segments": [
            "A: Do you think I could use your mobile?\nB: ",
            " (afraid / can’t. don’t have / with me.)"
          ],
          "answers": [
            [
              "I’m afraid you can’t. I don’t have it with me.",
              "I'm afraid you can't. I don't have it with me.",
              "I am afraid you cannot. I do not have it with me."
            ]
          ]
        },
        {
          "id": "4",
          "number": 4,
          "prompt": "",
          "input": "gaps",
          "segments": [
            "A: Do you fancy coming to my party on Friday evening?\nB: ",
            " (nice / of you to ask me. play in a band / every Friday.)"
          ],
          "answers": [
            [
              "It’s nice of you to ask me. But I play in a band every Friday.",
              "It's nice of you to ask me. But I play in a band every Friday.",
              "It is nice of you to ask me. But I play in a band every Friday."
            ]
          ]
        },
        {
          "id": "5",
          "number": 5,
          "prompt": "",
          "input": "gaps",
          "segments": [
            "A: Would you like to meet up some time this weekend?\nB: ",
            " (kind / of you to ask us. go to London / every weekend.)"
          ],
          "answers": [
            [
              "It’s kind of you to ask us. But we go to London every weekend.",
              "It's kind of you to ask us. But we go to London every weekend.",
              "It is kind of you to ask us. But we go to London every weekend."
            ]
          ]
        },
        {
          "id": "6",
          "number": 6,
          "prompt": "",
          "input": "gaps",
          "segments": [
            "A: Can you help me with my homework?\nB: ",
            " (no / sorry. go out / this evening.)"
          ],
          "answers": [
            [
              "No, I’m sorry. I’m going out this evening.",
              "No, I'm sorry. I'm going out this evening.",
              "No, I am sorry. I am going out this evening."
            ]
          ]
        }
